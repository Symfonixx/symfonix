{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "packages/visitor-tracking",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": "^8.3",
        "barryvdh/laravel-dompdf": "^3.1",
        "botman/botman": "^2.8",
        "botman/driver-web": "^1.5",
        "cloudstudio/ollama-laravel": "^1.1",
        "danielme85/laravel-log-to-db": "^4.1",
        "inertiajs/inertia-laravel": "^2.0",
        "intervention/image-laravel": "^4.1",
        "khaled.alshamaa/ar-php": "^7.0",
        "laravel/fortify": "^1.24",
        "laravel/framework": "^13.0",
        "laravel/pulse": "^1.4",
        "laravel/telescope": "^5.9",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^4.3",
        "maatwebsite/excel": "^3.1",
        "mcamara/laravel-localization": "^2.0",
        "monishroy/visitor-tracking": "@dev",
        "msaied/zkteco": "^0.2.2",
        "nwidart/laravel-modules": "^11.1",
        "predis/predis": "2.0",
        "spatie/laravel-data": "^4.11",
        "spatie/laravel-permission": "^6.10",
        "spatie/laravel-translatable": "^6.9",
        "stichoza/google-translate-php": "^5.2",
        "tightenco/ziggy": "^2.4",
        "unisharp/laravel-filemanager": "^2.12",
        "vdhicts/read-time": "^4.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.3",
        "barryvdh/laravel-ide-helper": "^3.5",
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.1",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "Modules/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"

        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "merge-plugin": {
            "include": [
                "Modules/*/composer.json"
            ]
        }
    },
    "config": {
        "audit": {
            "block-insecure": false
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
