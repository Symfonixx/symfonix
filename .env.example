APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
DEBUGBAR_ENABLED=true
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hado_saas
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# MTA-STS (email transport security). Also configure DNS at your provider:
#   mta-sts.{domain}     A/CNAME → this application host
#   _mta-sts.{domain}    TXT "v=STSv1; id={MTA_STS_DNS_ID}"
MTA_STS_MODE=enforce
MTA_STS_MAX_AGE=86400
MTA_STS_MX=mail.symfonix.io
MTA_STS_DNS_ID=2026072701

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Built-in documentation site at /docs (set to false to disable)
DOCS_ENABLED=true

# Finance / multi-currency (Fixer.io). Prefer System Configurations → Finance for the key.
# Free Fixer plans only allow EUR as base; the app cross-converts to your default currency.
# data.fixer.io uses ?access_key=… ; api.apilayer.com/fixer uses the apikey header.
FINANCE_DEFAULT_CURRENCY=USD
FINANCE_SUPPORTED_CURRENCIES=USD,EUR,GBP,TRY
FIXER_API_KEY=
FIXER_BASE_URL=https://data.fixer.io/api

# WhatsApp Cloud API (Meta). Prefer APIs & Integrations → WhatsApp; DB values override .env.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ZKTeco fingerprint terminal. Prefer System Configurations → Fingerprint; DB values override .env.
FINGERPRINT_ENABLED=false
FINGERPRINT_HOST=
FINGERPRINT_PORT=4370
FINGERPRINT_COMM_KEY=0
FINGERPRINT_TIMEOUT=10
FINGERPRINT_NAME_ENCODING=UTF-8
